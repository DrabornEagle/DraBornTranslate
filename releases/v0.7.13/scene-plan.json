titleTr":"Görev kapanışı","category":"gameplay","environmentTr":"Numaralı görev konuşması"},[402,403,404,405,406,407,408,409,410,411,412,413,438,414,434,415,442,439,436,416,417,441,418,419,420,421,422,423,424,425,426,435,428]]],"source":"https://six.mics.dev/dialogue?mission=t:CSC_ECO_WHALE","sourceRows":443},"twin-flames":{"scenes":[[{"id":"timeline-script-0","titleTr":"Görev başlangıcı","category":"gameplay","environmentTr":"Numaralı görev konuşması"},[330,331,332,333,396,334,335,336,337,353,338,339,352,340,341,342,343,344,345,346,348,397,349,350,351]],[{"id":"timeline-script-10000","titleTr":"Görev kapanışı","category":"gameplay","environmentTr":"Numaralı görev konuşması"},[310,311,312,315,316,317,318,319,320,321,322,323,324,325,326,327,328,329]]],"source":"https://six.mics.dev/dialogue?mission=t:CSC_ECO_FRACK","sourceRows":399},"dodo-rise":{"scenes":[[{"id":"timeline-script-0","titleTr":"Görev başlangıcı","category":"gameplay","environmentTr":"Numaralı görev konuşması"},[313,314,315,316,317,580,318,319,320,321,322,325,327,328]],[{"id":"timeline-script-2","titleTr":"Görev aşaması 2","category":"gameplay","environmentTr":"Numaralı görev konuşması"},[174,116,172,119,120,121,122,623,123,611,124,125,126,744,127,177,128,612,129,178,130,613,131,614,132,133,615,134,135,136,786,137,787,138,168,139,140,788,142,141,149,150,625,179,789,618,154,156,157,158,619,161,620,162,164,167,169,621,171,170]],[{"id":"timeline-script-10000","titleTr":"Görev kapanışı","category":"gameplay","environmentTr":"Numaralı görev konuşması"},[576,647,648,649,650,651,652,653,654,655,656,657,658,659,660,661,662,663,665,666,667,668,771,669,772,670,671,773,774,672,673,674,676,679,698,775,701,702,703]]],"source":"https://six.mics.dev/dialogue?mission=t:CSC_ECO_FINAL","sourceRows":792},"cti-pil-rd-bc-parent":{"scenes":[[{"id":"timeline-cal-arama","titleTr":"Arama sırasında Cal’le konuşma","category":"call","environmentTr":"Telefon görüşmesi"},[{"type":"dialogue","subtitleKey":"ff38c960710ff407","sceneId":"unplaced-dialogue","tr":"Jay, naber dostum?","speaker":"Cal Hampton","npc":true},{"type":"dialogue","subtitleKey":"6220d1500c8b4c19","sceneId":"unplaced-dialogue","tr":"Selam dostum. The Rivers'ta Donnie için bir paket arıyorum. Biliyor musun neyi aradığımı?","speaker":"Jason Duval","npc":false},{"type":"dialogue","subtitleKey":"7069b48d2b7a768c","sceneId":"unplaced-dialogue","tr":"He, biraz sıçtı, değil mi? Herif zor yürüyordu. Her zamanki gibi, tuğla paket, can yeleği, verici.","speaker":"Cal Hampton","npc":true},{"type":"dialogue","subtitleKey":"31455aa927363c93","sceneId":"unplaced-dialogue","tr":"Biri senden önce davranmadıysa buralarda bir yerde olmalı.","speaker":"Cal Hampton","npc":true},{"type":"dialogue","subtitleKey":"41cf60e6ddff84a8","sceneId":"unplaced-dialogue","tr":"Tamam, sağ ol.","speaker":"Jason Duval","npc":false},{"type":"dialogue","subtitleKey":"7aa8ee63ae20bf4e","sceneId":"unplaced-dialogue","tr":"Hâlâ diğerlerinin sinyalini arıyorum. Bir şey yakalarsam haber veririm.","speaker":"Cal Hampton","npc":true}]],[{"id":"timeline-hamlet-balikci","titleTr":"Balık noktasında paketin izini sürme","category":"gameplay","environmentTr":"Hamlet’teki balıkçı"},[{"type":"dialogue","subtitleKey":"a525b795f504e277","sceneId":"unplaced-dialogue","tr":"Galiba biri senden önce davranmış."},{"type":"dialogue","subtitleKey":"e9690b1dd241dc4b","sceneId":"unplaced-dialogue","tr":"Öyle mi? Kimmiş o?","speaker":"Jason Duval","npc":false},{"type":"dialogue","subtitleKey":"f230ad2bba301c8d","sceneId":"unplaced-dialogue","tr":"Birkaç yavşak. Buralarda bir şeyler karıştırıyordu. Senin miydi?"},{"type":"dialogue","subtitleKey":"e805c6fb9eb06ca2","sceneId":"unplaced-dialogue","tr":"Evet. Uçağımdan düştü. Nereye gittiklerini gördün mü?","speaker":"Jason Duval","npc":false},{"type":"dialogue","subtitleKey":"2e658da953bdc4c6","sceneId":"unplaced-dialogue","tr":"Ha, evet. Nehrin aşağısındaki kulübedeler. Oraya çökene kadar hep orada balık tutardım. Geri almaya gideceksen dikkat et. Dedim ya, yavşak bunlar."},{"type":"dialogue","subtitleKey":"03a0bb94a8c2db49","sceneId":"unplaced-dialogue","tr":"Peki. Ben de yavşaklık ederim. Sağ ol.","speaker":"Jason Duval","npc":false}]],[{"id":"timeline-hamlet-kulube","titleTr":"Nehir aşağısındaki kulübeye ulaşma","category":"gameplay","environmentTr":"Kingfishers’ın kulübesi"},[{"type":"dialogue","subtitleKey":"ac8e7bdb84255224","sceneId":"unplaced-dialogue","tr":"Al bakalım. Tadına bak şunun."},{"type":"dialogue","subtitleKey":"eac8923ae70048fd","sceneId":"unplaced-dialogue","tr":"Şu piçe dikkat et. Bu mala bayılıyor. Kafayı yedi herif!"},{"type":"dialogue","subtitleKey":"0702a250d29aa024","sceneId":"unplaced-dialogue","tr":"Şimdi mi kötü diyorsun? Oo, sen onu iki gün aralıksız kafayı çektikten sonra gör. Fena bir orospu çocuğuna dönüşecek!"},{"type":"dialogue","subtitleKey":"6a12e55eadd7966f","sceneId":"unplaced-dialogue","tr":"Bu daha başlangıç, oğlum!"},{"type":"dialogue","subtitleKey":"2c14cee8e1dc172a","sceneId":"unplaced-dialogue","tr":"Vay! Hassiktir! Bu timsah kokain kadar beyaz!"}]],[{"id":"timeline-donnie-geri-donus","titleTr":"Paketi bulduğunu Donnie’ye bildirme","category":"call","environmentTr":"Telefon görüşmesi"},[{"type":"dialogue","subtitleKey":"39c26838c0fc30c5","sceneId":"unplaced-dialogue","tr":"Donnie, düşen paketi buldum...","speaker":"Jason Duval","npc":false},{"type":"dialogue","subtitleKey":"de577d423bfeabd2","sceneId":"unplaced-dialogue","tr":"Tamam. Bir dahaki sefere uçağa binip haritayı okumaya kalkarsam... Hani şu hapishane kuşunun partilerinden birinde kafayı hayvan gibi çektikten sonra...","speaker":"Donnie","npc":true},{"type":"dialogue","subtitleKey":"febbadc23616c268","sceneId":"unplaced-dialogue","tr":"Belki bana dur demen lazımdır. Ha? Ha? Malı karavana getir. Şunu da unutma. Bayrak havada değilse Donnie havadadır.","speaker":"Donnie","npc":true},{"type":"dialogue","subtitleKey":"97f6c2dff8b2b1a4","sceneId":"unplaced-dialogue","tr":"Güzel. Sağ ol diyecektin galiba, neyse.","speaker":"Jason Duval","npc":false}]]],"source":"https://six.mics.dev/missions/cti-pil-rd-bc-parent","sourceRows":5}}}
