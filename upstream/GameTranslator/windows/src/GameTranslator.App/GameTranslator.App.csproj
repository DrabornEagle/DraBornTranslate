<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>GameTranslator</AssemblyName>
    <RootNamespace>GameTranslator.App</RootNamespace>
    <ApplicationIcon>Assets\GameTranslator.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Version>1.8.51</Version>
    <AssemblyVersion>1.8.51.0</AssemblyVersion>
    <FileVersion>1.8.51.0</FileVersion>
    <!-- Velopack kurulum ve güncelleme kancaları WPF başlamadan çalışmalı (Program.Main). -->
    <StartupObject>GameTranslator.App.Program</StartupObject>
  </PropertyGroup>

  <!-- Paket sunucusu (CouchSubs'ın, izinle): yeni ve düzeltilmiş paketler buradan iner (PackUpdater). Boş verilirse kapalı. -->
  <PropertyGroup>
    <GameTranslatorPacksUrl Condition="'$(GameTranslatorPacksUrl)' == ''">https://gametranslator-packs.gametranslator-pool.workers.dev</GameTranslatorPacksUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="GameTranslatorPacksUrl" Value="$(GameTranslatorPacksUrl)" />
  </ItemGroup>

  <!-- Uygulama güncellemesi: bu adresin altındaki releases.win.json ve .nupkg dosyaları (Services/Updater.cs). GitLab'ın
       paket deposunda sabit bir "kanal": gametranslator-update / win (dosyaları scripts/publish-gitlab-release.py yükler).
       Sürüm sayfasının kalıcı bağlantısı (/-/releases/permalink/...) yerine paket API'si kullanılır: web sayfaları
       tarayıcı olmayan istemcilere 429 dönebiliyor (2026-11-17'de görüldü), paket indirme adresi dönmüyor.
       Boş verilirse güncelleme kapalı. -->
  <PropertyGroup>
    <GameTranslatorUpdateUrl Condition="'$(GameTranslatorUpdateUrl)' == ''">https://gitlab.com/api/v4/projects/88821849/packages/generic/gametranslator-update/win</GameTranslatorUpdateUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="GameTranslatorUpdateUrl" Value="$(GameTranslatorUpdateUrl)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- Xbox ev yayını yardımcı programı (windows/xbox-bridge; önce orada "npm ci" ve "npm run build", node.exe dist'e kopyalanır).
       dist yoksa uygulama Xbox ev yayını olmadan derlenir. -->
  <ItemGroup>
    <Content Include="..\..\xbox-bridge\dist\bridge.cjs;..\..\xbox-bridge\dist\player.html;..\..\xbox-bridge\dist\player.js" Link="xbox-bridge\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\xbox-bridge\dist\node.exe" Condition="Exists('..\..\xbox-bridge\dist\node.exe')" Link="xbox-bridge\node.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\xbox-bridge\dist\licenses\*" Link="xbox-bridge\licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <!-- Yaygın İngilizce sözcükler (SCOWL/ESDB, Kevin Atkinson; izin metni THIRD-PARTY-NOTICES.md'de). -->
    <EmbeddedResource Include="Assets\english-words.txt.gz" LogicalName="GameTranslator.App.Assets.english-words.txt.gz" />
    <!-- ShellWindow.xaml pencere simgesi olarak bunu okur; ApplicationIcon yalnız exe simgesidir. -->
    <Resource Include="Assets\GameTranslator.ico" />
    <!-- Inter (SIL Open Font License 1.1; Assets\Fonts\Inter-LICENSE): mobil uygulamayla aynı yazı tipi. -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <!-- Destek kartının animasyonu (CC0; Assets\Support\CREDITS.md). -->
    <Resource Include="Assets\Support\*.png" />
  </ItemGroup>

  <!-- TV uygulaması paketleri: dist/tv-app ve tv/packages altındaki paketleri tv-app/ klasörüne kopyalar -->
  <ItemGroup>
    <Content Include="..\..\..\dist\tv-app\*.ipk;..\..\..\dist\tv-app\*.wgt;..\..\..\dist\tv-app\*.apk;..\..\..\tv\packages\*.ipk;..\..\..\tv\packages\*.wgt;..\..\..\tv\packages\*.apk" Link="tv-app\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- PS5 Otomatik Eşleştirme Yardımcıları (Node.js & playactor betiği) -->
  <ItemGroup>
    <Content Include="..\..\..\scripts\bin\node.exe" Link="helpers\node.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\..\scripts\bin\node.exe')" />
    <Content Include="..\..\..\scripts\ps5-register.js" Link="helpers\ps5-register.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\..\scripts\ps5-register.js')" />
    <Content Include="..\..\..\scripts\ps5-register\node_modules\**\*" Link="helpers\ps5-register\node_modules\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\..\scripts\ps5-register\node_modules')" />
  </ItemGroup>

  <!-- Chiaki Taşınabilir Remote Play Motoru -->
  <ItemGroup>
    <Content Include="..\..\..\chiaki\**\*" Link="chiaki\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameTranslator.Core\GameTranslator.Core.csproj" />
    <ProjectReference Include="..\GameTranslator.Translation\GameTranslator.Translation.csproj" />
    <ProjectReference Include="..\GameTranslator.RemotePlay\GameTranslator.RemotePlay.csproj" />
    <ProjectReference Include="..\GameTranslator.Shell\GameTranslator.Shell.csproj" />
    <ProjectReference Include="..\GameTranslator.TvInstall\GameTranslator.TvInstall.csproj" />
  </ItemGroup>

  <!-- Yerel çevirinin CTranslate2 çalışma zamanı (scripts/prepare-ct2-runtime.py hazırlar): uygulama klasörüne "ct2"
       olarak kopyalanır. Hazırlanmamışsa uygulama ONNX motoruyla çalışır. -->
  <ItemGroup Condition="Exists('..\..\build\ct2\python.exe')">
    <None Include="..\..\build\ct2\**\*" Exclude="..\..\build\ct2\**\__pycache__\**" LinkBase="ct2" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
